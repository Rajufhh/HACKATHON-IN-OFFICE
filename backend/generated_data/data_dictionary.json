      "reviewer_id": {
        "allowed_values_or_validation": "FK reviewers.id",
        "required": true,
        "type": "integer",
        "unique": false,
        "units": null
      }
    },
    "lifecycle_states": [
      "BREACH_ESTABLISHED",
      "NO_BREACH",
      "INSUFFICIENT_EVIDENCE",
      "REFERRED_FOR_FURTHER_REVIEW"
    ],
    "table": "case_decisions"
  },
  "EvidenceItem": {
