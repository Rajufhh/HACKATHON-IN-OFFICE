      "id": {
        "allowed_values_or_validation": "positive primary key",
        "required": true,
        "type": "integer",
        "unique": true,
        "units": null
      },
      "mime_type": {
        "allowed_values_or_validation": "application/json",
        "required": false,
        "type": "string|null",
        "unique": false,
        "units": null
      },
      "sha256_hash": {
        "allowed_values_or_validation": "64-character SHA-256 hex",
