      "source_reference": {
        "allowed_values_or_validation": "synthetic:// URI only",
        "required": false,
        "type": "string|null",
        "unique": false,
        "units": null
      },
      "title": {
        "allowed_values_or_validation": "non-empty synthetic description",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      }
    },
    "lifecycle_states": [
      "APPENDED; metadata captured at added_at"
    ],
    "table": "evidence_items"
  },
  "IntegrityRule": {
    "cardinality": "One rule applies to many flags; rule ranges do not overlap.",
    "effective_date_notes": "The application model has created_at but no effective_from/effective_to. Synthetic rules are fixed for the dataset and do not claim historical validity.",
    "fields": {
      "action": {
        "allowed_values_or_validation": "INFORMATION|REVIEW|PRIORITY_REVIEW",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      },
      "created_at": {
        "allowed_values_or_validation": "synthetic fixed date",
        "required": true,
        "type": "datetime",
        "unique": false,
        "units": "UTC-naive ISO datetime"
      },
      "description": {
        "allowed_values_or_validation": "states review is not guilt",
        "required": false,
        "type": "string|null",
        "unique": false,
        "units": null
      },
      "id": {
        "allowed_values_or_validation": "positive primary key",
        "required": true,
        "type": "integer",
        "unique": true,
        "units": null
      },
      "max_similarity": {
        "allowed_values_or_validation": "0..100 inclusive; >= min_similarity",
        "required": true,
        "type": "integer",
        "unique": false,
        "units": "percentage points"
      },
      "min_similarity": {
        "allowed_values_or_validation": "0..100 inclusive; <= max_similarity",
        "required": true,
        "type": "integer",
        "unique": false,
        "units": "percentage points"
      },
      "rule_code": {
        "allowed_values_or_validation": "INT-2026-NNNNNN",
        "required": true,
        "type": "string",
        "unique": true,
        "units": null
      },
      "rule_name": {
        "allowed_values_or_validation": "non-empty",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      }
    },
    "lifecycle_states": [
      "INFORMATION",
      "REVIEW",
      "PRIORITY_REVIEW"
    ],
    "table": "integrity_rules"
  },
