{
  "Appeal": {
    "cardinality": "One appeal per decision (unique FK); each appeal belongs to one learner, optionally has one assigned reviewer, and has many events/evidence snapshots.",
    "effective_date_notes": "submitted_at, assigned_at, and resolved_at record workflow timing.",
    "fields": {
      "appeal_code": {
        "allowed_values_or_validation": "APL-<case-id>-01",
        "required": true,
        "type": "string",
        "unique": true,
        "units": null
      },
      "assigned_at": {
        "allowed_values_or_validation": "on or after submitted_at",
        "required": false,
        "type": "datetime|null",
        "unique": false,
        "units": "UTC-naive ISO datetime"
      },
      "assigned_reviewer_id": {
        "allowed_values_or_validation": "FK reviewers.id; must differ from original decision-maker",
        "required": false,
        "type": "integer|null",
        "unique": false,
        "units": null
      },
      "decision_id": {
        "allowed_values_or_validation": "unique FK case_decisions.id",
        "required": true,
        "type": "integer",
        "unique": true,
        "units": null
      },
      "grounds": {
        "allowed_values_or_validation": "10..10000 characters",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      },
      "id": {
        "allowed_values_or_validation": "positive primary key",
        "required": true,
        "type": "integer",
        "unique": true,
        "units": null
      },
      "learner_id": {
        "allowed_values_or_validation": "FK learners.id; must match case learner",
        "required": true,
        "type": "integer",
        "unique": false,
        "units": null
      },
      "outcome": {
        "allowed_values_or_validation": "UPHELD|OVERTURNED|REMANDED; set only when DECIDED",
        "required": false,
        "type": "string|null",
        "unique": false,
        "units": null
      },
      "outcome_rationale": {
        "allowed_values_or_validation": "10..10000 characters when resolved",
        "required": false,
        "type": "string|null",
        "unique": false,
        "units": null
      },
      "resolved_at": {
        "allowed_values_or_validation": "on or after submitted_at",
        "required": false,
        "type": "datetime|null",
        "unique": false,
        "units": "UTC-naive ISO datetime"
      },
      "status": {
        "allowed_values_or_validation": "SUBMITTED|UNDER_REVIEW|DECIDED|WITHDRAWN",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      },
      "submitted_at": {
        "allowed_values_or_validation": "after original decision",
        "required": true,
        "type": "datetime",
        "unique": false,
        "units": "UTC-naive ISO datetime"
      }
    },
    "lifecycle_states": [
      "SUBMITTED",
      "UNDER_REVIEW",
      "DECIDED",
      "WITHDRAWN"
    ],
    "table": "appeals"
  },
  "Assessment": {
