        "units": "UTC-naive ISO datetime"
      },
      "id": {
        "allowed_values_or_validation": "positive, unique primary key",
        "required": true,
        "type": "integer",
        "unique": true,
        "units": null
      },
      "max_marks": {
        "allowed_values_or_validation": "positive",
        "required": true,
        "type": "integer",
        "unique": false,
        "units": "marks"
      },
      "status": {
        "allowed_values_or_validation": "PUBLISHED",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      },
      "title": {
        "allowed_values_or_validation": "non-empty synthetic title",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      }
