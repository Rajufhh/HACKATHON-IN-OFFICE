  "Case": {
    "cardinality": "A case belongs to one learner; CaseFlag is a bridge from case to flags (one case to many flags, each flag at most one case); a case has many events, evidence items, assignments, and decisions.",
    "effective_date_notes": "Lifecycle timestamps are recorded where supported by the current model.",
    "fields": {
      "case_code": {
        "allowed_values_or_validation": "CASE-2026-NNNNNN",
        "required": true,
        "type": "string",
        "unique": true,
        "units": null
      },
      "closed_at": {
        "allowed_values_or_validation": "after decision time when CLOSED",
        "required": false,
        "type": "datetime|null",
        "unique": false,
        "units": "UTC-naive ISO datetime"
      },
      "description": {
        "allowed_values_or_validation": "states review is not a guilt finding",
        "required": false,
        "type": "string|null",
        "unique": false,
        "units": null
      },
      "id": {
        "allowed_values_or_validation": "positive primary key",
        "required": true,
        "type": "integer",
        "unique": true,
        "units": null
      },
      "learner_id": {
        "allowed_values_or_validation": "FK learners.id",
        "required": true,
        "type": "integer",
        "unique": false,
        "units": null
      },
      "opened_at": {
        "allowed_values_or_validation": "after report analysis",
        "required": true,
        "type": "datetime",
        "unique": false,
        "units": "UTC-naive ISO datetime"
      },
      "priority": {
        "allowed_values_or_validation": "LOW|NORMAL|HIGH|URGENT",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      },
      "status": {
        "allowed_values_or_validation": "OPEN|ASSIGNED|UNDER_REVIEW|DECISION_PENDING|CLOSED; injected anomalies documented separately",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      },
      "title": {
        "allowed_values_or_validation": "non-empty",
        "required": true,
        "type": "string",
        "unique": false,
        "units": null
      }
    },
    "lifecycle_states": [
      "OPEN",
      "ASSIGNED",
      "UNDER_REVIEW",
      "DECISION_PENDING",
      "CLOSED"
    ],
    "table": "cases"
  },
  "Decision": {
    "cardinality": "Each decision belongs to one case and one reviewer; DecisionEvidence links a decision to many evidence items with decision-time snapshots.",
    "effective_date_notes": "decided_at is the decision effective timestamp.",
    "fields": {
      "case_id": {
        "allowed_values_or_validation": "FK cases.id",
        "required": true,
        "type": "integer",
        "unique": false,
        "units": null
      },
      "decided_at": {
        "allowed_values_or_validation": "after evidence reviewed and before case closure",
        "required": true,
        "type": "datetime",
        "unique": false,
        "units": "UTC-naive ISO datetime"
      },
      "decision_code": {
        "allowed_values_or_validation": "DEC-2026-NNNNNN",
        "required": true,
        "type": "string",
        "unique": true,
        "units": null
      },
      "id": {
        "allowed_values_or_validation": "positive primary key",
        "required": true,
        "type": "integer",
        "unique": true,
        "units": null
      },
      "outcome": {
        "allowed_values_or_validation": "BREACH_ESTABLISHED|NO_BREACH|INSUFFICIENT_EVIDENCE|REFERRED_FOR_FURTHER_REVIEW",
